[Unit]
Description=Lantern Server Manager
Documentation=https://github.com/getlantern/lantern-server-manager
Wants=network-online.target firewalld.service
After=syslog.target network-online.target remote-fs.target nss-lookup.target firewalld.service

[Service]
User=root
ExecStart=/usr/bin/lantern-server-manager serve -d /opt/lantern/data
ExecStop=/bin/kill -s QUIT $MAINPID
PrivateTmp=true
StandardOutput=journal+console
StandardError=journal+console
[Install]
WantedBy=multi-user.target
